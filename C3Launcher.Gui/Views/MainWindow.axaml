<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:C3Launcher.Gui.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="C3Launcher.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/c3launcher.ico"
        Title="C3Launcher"
        Width="1100" Height="700" MinWidth="900" MinHeight="560"
        Background="{DynamicResource AppBackground}"
        FontFamily="{DynamicResource UiFont}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="32,76,*,Auto">

    <!-- title bar -->
    <Border Grid.Row="0" Name="TitleBar"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                    Margin="12,0,0,0" VerticalAlignment="Center">
          <Image Source="/Assets/c3launcher-64.png" Width="16" Height="16" />
          <TextBlock Text="C3Launcher" Classes="dim" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="caption" Click="OnMinimize">
            <!-- A flat line has zero geometry height, which Stretch="Uniform" collapses. -->
            <Rectangle Width="11" Height="1" Fill="{DynamicResource TextDim}" />
          </Button>
          <Button Classes="caption" Click="OnMaximize">
            <Path Data="{StaticResource IconMaximize}" Width="10" Height="10" Stretch="Uniform"
                  Stroke="{DynamicResource TextDim}" StrokeThickness="1.6" />
          </Button>
          <Button Classes="caption close" Click="OnClose">
            <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                  Stroke="{DynamicResource TextDim}" StrokeThickness="1.6" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- header strip -->
    <Border Grid.Row="1"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderNormal}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto"
            VerticalAlignment="Center" Margin="16,0">

        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="mono" VerticalAlignment="Center"
                   Foreground="{DynamicResource Amber}" FontSize="11" LineHeight="14"
                   Text="   /\_/\&#x0a;  ( ^.^ )&#x0a;   &gt; ~ &lt;" />

        <TextBlock Grid.Row="0" Grid.Column="1" Text="ACCOUNT" Classes="label" Margin="28,0,0,3" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="28,0,0,0">
          <TextBlock VerticalAlignment="Center">
            <Run Text="{Binding AccountEmail}" FontSize="13" />
            <Run Text="  " />
            <Run Text="{Binding AccountOrg}" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFaint}" />
          </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="IMAGE" Classes="label" Margin="28,0,0,3" />
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="28,0,0,0">
            <TextBlock VerticalAlignment="Center">
              <Run Text="{Binding ImageName}" FontSize="13" />
              <Run Text="  " />
              <Run Text="{Binding ImageVersion}" FontSize="11" Foreground="{DynamicResource TextDim}" />
            </TextBlock>

            <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                    Background="{DynamicResource GreenWash}" BorderBrush="{DynamicResource GreenEdge}" BorderThickness="1"
                    IsVisible="{Binding !UpdateAvailable}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="{StaticResource IconCheck}" Width="10" Height="10" Stretch="Uniform"
                      Stroke="{DynamicResource Green}" StrokeThickness="3" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UpdateText}" FontSize="10" Foreground="{DynamicResource Green}" />
              </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                    Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentEdge}" BorderThickness="1"
                    IsVisible="{Binding UpdateAvailable}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="{StaticResource IconArrowDown}" Width="10" Height="10" Stretch="Uniform"
                      Stroke="{DynamicResource Accent}" StrokeThickness="2.4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UpdateText}" FontSize="10" Foreground="{DynamicResource Accent}" />
              </StackPanel>
            </Border>
        </StackPanel>

        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Center"
                Command="{Binding RebuildCommand}"
                Classes.primary="{Binding UpdateAvailable}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="{StaticResource IconRefresh}" Width="13" Height="13" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" />
            <TextBlock Text="Rebuild" Foreground="{Binding $parent[Button].Foreground}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- body -->
    <Grid Grid.Row="2" ColumnDefinitions="322,*">

      <!-- left pane -->
      <Border Grid.Column="0"
              Background="{DynamicResource PanelBackground}"
              BorderBrush="{DynamicResource BorderNormal}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <Panel Grid.Row="0" Margin="10,10,10,8">
            <TextBox Name="FilterBox" Text="{Binding FilterText}" PlaceholderText="Filter projects" Padding="30,0,10,0" />
            <Path Data="{StaticResource IconSearch}" Width="13" Height="13" Stretch="Uniform"
                  Stroke="{DynamicResource TextFaint}" StrokeThickness="2"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
          </Panel>

          <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="52" Margin="6,0,8,0">
                  <Path Grid.Column="0" Data="{StaticResource IconStar}" Width="12" Height="12" Stretch="Uniform"
                        Fill="{DynamicResource Amber}" VerticalAlignment="Center"
                        IsVisible="{Binding Pinned}" />
                  <Border Grid.Column="0" Width="12" IsVisible="{Binding !Pinned}" />

                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="7,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}" Classes="mono faint" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="3" Padding="5,2"
                          BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                          IsVisible="{Binding PinAccelerator, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding PinAccelerator}" Classes="mono faint" FontSize="10" />
                  </Border>

                  <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center"
                           Fill="{DynamicResource Green}" IsVisible="{Binding IsRunning}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
            <Button Classes="link" Command="{Binding AddProjectCommand}" Margin="12,0" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform"
                      Stroke="{DynamicResource TextFaint}" StrokeThickness="2" />
                <TextBlock Text="Add project…" Classes="faint" FontSize="11.5" />
              </StackPanel>
            </Button>
          </Border>
        </Grid>
      </Border>

      <!-- right pane -->
      <Grid Grid.Column="1" Margin="20,18,20,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
            IsVisible="{Binding HasSelection}">

        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="{Binding SelectedProject.Name}" Classes="title" />
          <TextBlock Text="{Binding SelectedProject.Path}" Classes="mono dim" FontSize="11.5" />
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderNormal}" Margin="0,16,0,0" />

        <!-- mount filtering -->
        <StackPanel Grid.Row="2" Spacing="9" Margin="0,16">
          <TextBlock Text="MOUNT FILTERING" Classes="label" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center">
              <Run Text="{Binding MountSummary}" FontSize="13" />
              <Run Text="  via  " FontSize="12" Foreground="{DynamicResource TextFaint}" />
              <Run Text=".mountignore" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                   Foreground="{DynamicResource TextDim}" />
            </TextBlock>

            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="4" Padding="9,3" VerticalAlignment="Center"
                    Background="{DynamicResource AmberWash}" BorderBrush="{DynamicResource AmberEdge}" BorderThickness="1"
                    IsVisible="{Binding HasBuildCritical}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconWarning}" Width="11" Height="11" Stretch="Uniform"
                      Stroke="{DynamicResource Amber}" StrokeThickness="2" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BuildCriticalCount, StringFormat='{}{0} build-critical'}"
                           FontSize="11" Foreground="{DynamicResource Amber}" />
              </StackPanel>
            </Border>

            <Button Grid.Column="3" Content="Preview…" Height="27" Padding="12,0" FontSize="11.5"
                    Command="{Binding PreviewMountsCommand}" />
          </Grid>
        </StackPanel>

        <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderSoft}" />

        <!-- launch options -->
        <StackPanel Grid.Row="4" Spacing="12" Margin="0,16">
          <TextBlock Text="LAUNCH OPTIONS" Classes="label" />

          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto" >
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Classes="dim" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left" Width="300"
                      ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Extra args" Classes="dim" VerticalAlignment="Center" Margin="0,10,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExtraArgs}" Margin="0,10,0,0"
                     PlaceholderText="--debug --verbose" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" />
          </Grid>

          <CheckBox Content="Skip the Claude Code update check" IsChecked="{Binding SkipUpdateCheck}" />
        </StackPanel>

        <Border Grid.Row="5" Height="1" Background="{DynamicResource BorderSoft}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="40" Margin="0,16,0,0" VerticalAlignment="Top">
          <StackPanel Spacing="4">
            <TextBlock Text="LAST OPENED" Classes="label" />
            <TextBlock Text="{Binding SelectedProject.LastOpenedText}" Classes="dim" FontSize="13" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="LAUNCHES" Classes="label" />
            <TextBlock Text="{Binding SelectedProject.LaunchCountText}" Classes="dim" FontSize="13" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
          <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="faint" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

          <Button Grid.Column="1" Command="{Binding OpenFolderCommand}" Height="32" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{DynamicResource TextDim}" StrokeThickness="2" />
              <TextBlock Text="Open folder" Classes="dim" />
            </StackPanel>
          </Button>

          <Button Grid.Column="2" Classes="primary" Command="{Binding LaunchCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconPlay}" Width="12" Height="12" Stretch="Uniform" Fill="White" />
              <TextBlock Text="Launch" Foreground="White" FontWeight="SemiBold" FontSize="12.5" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>

      <!-- empty state -->
      <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsVisible="{Binding !HasSelection}">
        <TextBlock Text="No project selected" Classes="dim" FontSize="14" HorizontalAlignment="Center" />
        <Button Content="Add project…" Command="{Binding AddProjectCommand}" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- sessions strip -->
    <Border Grid.Row="3"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderNormal}" BorderThickness="0,1,0,0">
      <StackPanel>

        <Button Height="38" Background="Transparent" BorderThickness="0" CornerRadius="0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Padding="16,0" Command="{Binding ToggleSessionsCommand}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Height is left unset: a chevron is 6 units tall in a 24 box, so a
                 square Path seats the glyph at the top of it rather than centred. -->
            <Path Grid.Column="0" Data="{StaticResource IconChevronUp}" Width="12" Stretch="Uniform"
                  Stroke="{DynamicResource TextDim}" StrokeThickness="2.4" VerticalAlignment="Center"
                  Margin="0,0,10,0" IsVisible="{Binding !SessionsExpanded}" />
            <Path Grid.Column="0" Data="{StaticResource IconChevronDown}" Width="12" Stretch="Uniform"
                  Stroke="{DynamicResource TextDim}" StrokeThickness="2.4" VerticalAlignment="Center"
                  Margin="0,0,10,0" IsVisible="{Binding SessionsExpanded}" />

            <Ellipse Grid.Column="1" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center"
                     Fill="{DynamicResource Green}" IsVisible="{Binding HasSessions}" />

            <TextBlock Grid.Column="2" Text="{Binding SessionsSummary}" Classes="dim" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding SessionsTotals}" Classes="mono faint" FontSize="11"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>

        <StackPanel IsVisible="{Binding SessionsExpanded}">
          <Grid ColumnDefinitions="210,84,88,66,*,78" Height="26" Margin="16,0"
                IsVisible="{Binding HasSessions}">
            <TextBlock Grid.Column="0" Text="SESSION" Classes="label" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="UPTIME" Classes="label" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="MEMORY" Classes="label" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="CPU" Classes="label" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="COMMAND" Classes="label" VerticalAlignment="Center" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Sessions}" MaxHeight="180">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionItemViewModel">
                <Border Background="{DynamicResource RaisedBackground}" Margin="0,0,0,1"
                        BorderBrush="{DynamicResource Green}" BorderThickness="2,0,0,0"
                        DoubleTapped="OnSessionDoubleTapped">
                  <Grid ColumnDefinitions="210,84,88,66,*,78" Height="44" Margin="14,0,16,0">
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ShortId}" Classes="mono faint" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Uptime}" Classes="mono" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Memory}" Classes="mono" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Cpu}" Classes="mono" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Command}" Classes="mono dim" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="5" Classes="danger" VerticalAlignment="Center"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StopSessionCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconStop}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource Red}" />
                        <TextBlock Text="Stop" Foreground="{DynamicResource Red}" FontSize="11" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
