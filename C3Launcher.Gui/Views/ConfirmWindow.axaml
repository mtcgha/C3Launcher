<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:C3Launcher.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="220"
        x:Class="C3Launcher.Gui.Views.ConfirmWindow"
        x:DataType="vm:ConfirmRequest"
        Icon="/Assets/c3launcher.ico"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        FontFamily="{DynamicResource UiFont}">

  <StackPanel>

    <StackPanel Margin="20,18" Spacing="11">
      <TextBlock Text="{Binding Title}" Classes="title" FontSize="15" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" Classes="dim" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" />

      <Border CornerRadius="4" Padding="10,8" IsVisible="{Binding HasWarning}"
              Background="{DynamicResource AmberWash}"
              BorderBrush="{DynamicResource AmberEdge}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0" Data="{StaticResource IconWarning}" Width="12" Height="12" Stretch="Uniform"
                Stroke="{DynamicResource Amber}" StrokeThickness="2"
                VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock Grid.Column="1" Text="{Binding Warning}" FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource AmberText}" />
        </Grid>
      </Border>
    </StackPanel>

    <Border Background="{DynamicResource PanelBackground}" Padding="20,12"
            BorderBrush="{DynamicResource BorderNormal}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Name="CancelButton" Content="Cancel" Height="30" Click="OnCancel" />
        <Button Classes="danger" Height="30" Content="{Binding ConfirmLabel}" Click="OnConfirm" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
