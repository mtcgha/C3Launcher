<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    <Setter Property="LetterSpacing" Value="0.9" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- secondary button -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Background" Value="{DynamicResource RaisedBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2F343C" />
    <Setter Property="BorderBrush" Value="#4A515B" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#22262D" />
  </Style>

  <!-- Fluent scales a pressed button to 98%; on a full-width row that reads as the
       strip flinching, so a press shows as a colour change only. -->
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- primary button -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Height" Value="32" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillHover}" />
    <Setter Property="BorderBrush" Value="#6EC4E4" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>

  <!-- danger button -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource RedWash}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RedEdge}" />
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3A2226" />
    <Setter Property="BorderBrush" Value="{DynamicResource RedEdgeHover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Red}" />
  </Style>

  <!-- full-width clickable row: hovers like a list item, not like a button -->
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.link Path">
    <Setter Property="Stroke" Value="{DynamicResource TextDim}" />
  </Style>

  <!-- The icon and label would otherwise keep their own colours: a Foreground on
       the presenter is inherited, and inheritance loses to a value set on the
       element itself. So the hover state reaches both of them directly. -->
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
  </Style>

  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.link:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Order matters: Avalonia takes the last matching setter rather than the most
       specific one, so the focus rules come after :pointerover to stop a focused
       box turning grey under the cursor. Every state is pinned here, including
       :focus-within — focus can land on the inner presenter instead of the
       TextBox, and an uncovered state falls through to the Fluent accent. -->
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="#4A515B" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>

  <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>

  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="#4A515B" />
  </Style>

  <Style Selector="ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="#4A515B" />
  </Style>

  <Style Selector="ComboBox:focus /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>

  <Style Selector="ComboBox:focus-within /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
  </Style>

  <!-- ComboBoxItem derives from ListBoxItem, but an Avalonia type selector matches
       the exact type, so the ListBoxItem rules below never reach the dropdown.
       Targeting ContentPresenter by type rather than by part name keeps this
       working whatever Fluent calls it. -->
  <Style Selector="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillHover}" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBackground}" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
